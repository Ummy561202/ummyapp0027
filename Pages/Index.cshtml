@page
@{
    ViewData["Title"] = "Bus Booking ";

    bool searched = Request.Method == "POST";
    string from = searched ? Request.Form["from"].ToString() : "";
    string to = searched ? Request.Form["to"].ToString() : "";
    string date = searched ? Request.Form["date"].ToString() : DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="text-center mb-4">Book Your Bus Ticket</h2>

    <form method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">From</label>
            <select name="from" class="form-select" required>
                <option value="">Select city</option>
                <option>Bengaluru</option>
                <option>Chennai</option>
                <option>Hyderabad</option>
                <option>Mumbai</option>
                <option>Pune</option>
                <option>Delhi</option>
                <option>Thimmapura</option>
                
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">To</label>
            <select name="to" class="form-select" required>
                <option value="">Select city</option>
                <option>Bengaluru</option>
                <option>Chennai</option>
                <option>Hyderabad</option>
                <option>Mumbai</option>
                <option>Pune</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Travel Date</label>
            <input type="date" name="date" class="form-control" value="@date" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Search Buses</button>
    </form>

    @if (searched)
    {
        <div class="alert alert-success mt-4">
            Searching buses from <strong>@from</strong> to <strong>@to</strong> on <strong>@date</strong>...
        </div>
    }
</div>
